# Copy to backend/.env and fill in. Never commit backend/.env.
# Every setting can also be set as a real environment variable (that wins over .env).

# SQLite file for the demo order database. Relative paths resolve from backend/.
DATABASE_PATH=data/aura.db

# Comma-separated browser origins allowed to call the API (no trailing slash).
# Local defaults: Vite dev server (5173) and `npm run preview` (4173).
# In production, set this to your deployed frontend's URL, e.g. https://aura-ai.example.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Time zone for "today", "6 PM" and day counts.
APP_TIMEZONE=Asia/Kolkata

# DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO

# ── Voice (Phase 4) ─────────────────────────────────────────────────────────
# Gemini API key from https://aistudio.google.com/apikey
# SECRET: server-side only. It is never sent to the browser; the browser gets a
# single-use ephemeral token instead. Leave empty to run without voice calling.
GEMINI_API_KEY=

# Live model for Aria's voice.
GEMINI_LIVE_MODEL=gemini-3.8-live

# Gemini API version for ephemeral tokens: v1beta (Google's docs) or v1alpha
# (what the SDKs still mention). Try v1alpha if calls fail to connect on v1beta.
GEMINI_API_VERSION=v1beta

# One of Gemini's 30 prebuilt voices, e.g. Sulafat (warm), Kore (firm), Achird (friendly).
GEMINI_VOICE=Sulafat

# Maximum call length in minutes (1-15; Gemini caps audio sessions at 15).
VOICE_SESSION_MINUTES=15

# New voice calls allowed per client IP per hour (each one mints a token).
VOICE_SESSIONS_PER_IP_PER_HOUR=30
